{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "arn:aws:iam::222222222222:role/TestBedrockGatewayExecutionRole",
      "RoleSessionName": "TestGatewaySession",
      "SessionDurationSeconds": 1800,
      "LocalProfileName": "",
      "UseLocalProfile": false,
      "ExternalId": "test-env-sts-token",
      "RefreshBufferMinutes": 5
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://test-ollama-svc:11434",
        "TimeoutSeconds": 30,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://test-lmstudio-svc:1234",
        "TimeoutSeconds": 30,
        "Enabled": false
      },
      "LlamaCpp": {
        "BaseUrl": "http://test-llamacpp-svc:8080",
        "TimeoutSeconds": 30,
        "Enabled": false
      }
    },
    "Security": {
      "AdminApiKey": "ug-test-admin-secret-2026",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 300,
      "AllowedCorsOrigins": [
        "https://test-gateway.internal.domain"
      ]
    },
    "Storage": {
      "DataDirectory": "/app/data",
      "RegistryFileName": "app_registry_test.json"
    }
  }
}
