{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "arn:aws:iam::333333333333:role/ProdBedrockGatewayExecutionRole",
      "RoleSessionName": "ProdUnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "",
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 10
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://internal-ollama-cluster.prod.svc.cluster.local:11434",
        "TimeoutSeconds": 120,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://internal-lmstudio.prod.svc.cluster.local:1234",
        "TimeoutSeconds": 120,
        "Enabled": false
      },
      "LlamaCpp": {
        "BaseUrl": "http://internal-llamacpp.prod.svc.cluster.local:8080",
        "TimeoutSeconds": 120,
        "Enabled": false
      }
    },
    "Security": {
      "AdminApiKey": "__PROD_ADMIN_API_KEY_INJECTED_VIA_SECRET__",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 1000,
      "AllowedCorsOrigins": [
        "https://gateway.enterprise.internal",
        "https://ai-platform.enterprise.internal"
      ]
    },
    "Storage": {
      "DataDirectory": "/app/data/prod",
      "RegistryFileName": "app_registry_prod.json"
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      }
    }
  }
}
