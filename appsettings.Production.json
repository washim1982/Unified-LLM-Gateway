{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Environment": "Production",
    "Aws": {
      "Region": "us-east-1",
      "AuthenticationType": "AssumeRole",
      "AssumeRoleArn": "arn:aws:iam::123456789012:role/UnifiedGatewayProdRole",
      "RoleSessionName": "UnifiedGatewayProductionSession",
      "SessionDurationSeconds": 3600,
      "ServiceUrl": null,
      "StsEndpoint": null,
      "S3Endpoint": null,
      "KmsEndpoint": null,
      "BedrockEndpoint": null
    },
    "Security": {
      "AdminApiKey": "PROD_CHANGE_ME_VIA_ENV_OR_SECRET_MANAGER",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 600,
      "EnableCloudKms": true,
      "KmsKeyId": "arn:aws:kms:us-east-1:123456789012:key/prod-cmk-id",
      "EnableTamperEvidentLogging": true,
      "S3AuditBucket": "prod-unified-gateway-audit-logs"
    },
    "Storage": {
      "StorageProvider": "S3",
      "S3BucketName": "prod-unified-gateway-audit-logs"
    }
  }
}
