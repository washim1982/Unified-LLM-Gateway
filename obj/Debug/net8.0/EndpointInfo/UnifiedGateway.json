  "components": {
    "schemas": {
      "AppStsInspectResponse": {
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "appId": {
            "type": "string",
            "nullable": true
          },
          "isAdmin": {
            "type": "boolean"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresInSeconds": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "isExpired": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "nullable": true
          },
          "callerId": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AppStsTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "tokenType": {
            "type": "string",
            "nullable": true
          },
          "appId": {
            "type": "string",
            "nullable": true
          },
          "durationSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": "string",
            "nullable": true
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "BedrockNativeGuardrailOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "guardrailIdentifier": {
            "type": "string",
            "nullable": true
          },
          "guardrailVersion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateAppRequest": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "type": "string",
            "nullable": true
          },
          "systemPrompt": {
            "type": "string",
            "nullable": true
          },
          "temperature": {
            "type": "number",
            "format": "double"
          },
          "maxTokens": {
            "type": "integer",
            "format": "int32"
          },
          "fallbackProvider": {
            "type": "string",
            "nullable": true
          },
          "fallbackModel": {
            "type": "string",
            "nullable": true
          },
          "allowedCidrs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "inputCostPerMillion": {
            "type": "number",
            "format": "double"
          },
          "outputCostPerMillion": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "GatewayError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GuardrailActionMode": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "GuardrailOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/components/schemas/GuardrailActionMode"
          },
          "scanOutputs": {
            "type": "boolean"
          },
          "outputMode": {
            "$ref": "#/components/schemas/GuardrailActionMode"
          },
          "pci": {
            "$ref": "#/components/schemas/PciGuardrailOptions"
          },
          "pii": {
            "$ref": "#/components/schemas/PiiGuardrailOptions"
          },
          "secrets": {
            "$ref": "#/components/schemas/SecretsGuardrailOptions"
          },
          "promptInjection": {
            "$ref": "#/components/schemas/PromptInjectionOptions"
          },
          "bedrockGuardrails": {
            "$ref": "#/components/schemas/BedrockNativeGuardrailOptions"
          }
        },
        "additionalProperties": false
      },
      "GuardrailTestRequest": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "$ref": "#/components/schemas/GuardrailActionMode"
          }
        },
        "additionalProperties": false
      },
      "InvokeAppRequest": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "nullable": true
          },
          "sessionId": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "temperature": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "max_tokens": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PciGuardrailOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "maskCreditCards": {
            "type": "boolean"
          },
          "maskIban": {
            "type": "boolean"
          },
          "maskCvv": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PiiGuardrailOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "maskSsn": {
            "type": "boolean"
          },
          "maskEmails": {
            "type": "boolean"
          },
          "maskPhoneNumbers": {
            "type": "boolean"
          },
          "maskPassports": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PromptInjectionOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
