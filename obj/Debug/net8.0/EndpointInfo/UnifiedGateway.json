    "/gateway/sts/token": {
      "post": {
        "tags": [
          "Gateway Invocation & STS Tokens"
        ],
        "summary": "Exchange a long-term API key for a short temporary secret (STS token) with custom TTL",
        "operationId": "GenerateStsToken",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppStsTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/gateway/sts/inspect": {
      "post": {
        "tags": [
