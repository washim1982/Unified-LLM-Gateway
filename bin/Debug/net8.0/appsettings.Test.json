{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Environment": "Test",
    "Aws": {
      "Region": "us-east-1",
      "AuthenticationType": "RolesAnywhere",
      "RolesAnywhere": {
        "TrustAnchorArn": "arn:aws:rolesanywhere:us-east-1:123456789012:trust-anchor/test-trust-anchor-id",
        "ProfileArn": "arn:aws:rolesanywhere:us-east-1:123456789012:profile/test-profile-id",
        "RoleArn": "arn:aws:iam::123456789012:role/OnPremBedrockExecutionRole-Test",
        "CertificatePath": "/etc/pki/gateway/test-client.crt",
        "PrivateKeyPath": "/etc/pki/gateway/test-client.key"
      }
    },
    "Security": {
      "EnableCloudKms": true,
      "KmsKeyId": "arn:aws:kms:us-east-1:123456789012:key/test-cmk-key-id",
      "EnableAuditLogPersistence": true
    },
    "Storage": {
      "StorageProvider": "HybridLokiS3",
      "DataDirectory": "/var/data/unified-gateway",
      "AuditLogDirectory": "audit_logs",
      "S3BucketName": "corp-unified-gateway-audit-test",
      "S3Prefix": "audit_logs/"
    }
  },
  "ConnectionStrings": {
    "GatewayDb": "Host=postgres-test.corp.internal;Port=5432;Database=gateway_test;Username=ug_svc;Password=ChangeInVault;SSL Mode=Require;"
  }
}
