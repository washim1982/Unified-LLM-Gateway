{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Environment": "Production",
    "Aws": {
      "Region": "us-east-1",
      "AuthenticationType": "RolesAnywhere",
      "RolesAnywhere": {
        "TrustAnchorArn": "arn:aws:rolesanywhere:us-east-1:123456789012:trust-anchor/prod-trust-anchor-id",
        "ProfileArn": "arn:aws:rolesanywhere:us-east-1:123456789012:profile/prod-profile-id",
        "RoleArn": "arn:aws:iam::123456789012:role/OnPremBedrockExecutionRole-Prod",
        "CertificatePath": "/etc/pki/gateway/prod-client.crt",
        "PrivateKeyPath": "/etc/pki/gateway/prod-client.key"
      }
    },
    "Security": {
      "EnableCloudKms": true,
      "KmsKeyId": "arn:aws:kms:us-east-1:123456789012:key/prod-cmk-key-id",
      "EnableAuditLogPersistence": true,
      "AuditLogRetentionDays": 365
    },
    "Storage": {
      "StorageProvider": "HybridLokiS3",
      "DataDirectory": "/var/data/unified-gateway",
      "AuditLogDirectory": "audit_logs",
      "S3BucketName": "corp-unified-gateway-audit-prod",
      "S3Prefix": "audit_logs/",
      "S3GlacierTransitionDays": 30
    }
  },
  "ConnectionStrings": {
    "GatewayDb": "Host=postgres-ha-cluster.corp.internal;Port=5432;Database=gateway_prod;Username=ug_prod_svc;Password=ChangeInVault;SSL Mode=Require;"
  }
}
