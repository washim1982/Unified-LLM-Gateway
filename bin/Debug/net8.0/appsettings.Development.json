{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "UnifiedGateway": "Debug"
    }
  },
  "Gateway": {
    "Environment": "Development",
    "Aws": {
      "Region": "us-east-1",
      "AuthenticationType": "Profile",
      "LocalProfileName": "default",
      "UseLocalProfile": true
    },
    "Security": {
      "EnableCloudKms": false,
      "EnableAuditLogPersistence": true
    },
    "Storage": {
      "StorageProvider": "LocalDisk",
      "DataDirectory": "./data",
      "AuditLogDirectory": "audit_logs",
      "S3BucketName": null
    }
  },
  "ConnectionStrings": {
    "GatewayDb": "Host=localhost;Port=5432;Database=gateway_dev;Username=postgres;Password=postgres;"
  }
}
