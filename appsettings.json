{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UnifiedGateway": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AuthenticationType": "Direct",
      "AssumeRoleArn": "arn:aws:iam::123456789012:role/S3ManagerRole",
      "RoleSessionName": "UnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "default",
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 5,
      "ServiceUrl": "http://localhost:5000",
      "StsEndpoint": "http://localhost:5001",
      "S3Endpoint": "http://localhost:5002",
      "KmsEndpoint": "http://localhost:5003",
      "BedrockEndpoint": "http://localhost:5004"
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 120,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://localhost:1234",
        "TimeoutSeconds": 120,
        "Enabled": true
      },
      "LlamaCpp": {
        "BaseUrl": "http://localhost:8080",
        "TimeoutSeconds": 120,
        "Enabled": true
      }
    },
    "Security": {
      "AdminApiKey": "ug-admin-secret-key-change-in-production",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 120,
      "AllowedCorsOrigins": [
        "*"
      ],
      "EnableCloudKms": true,
      "KmsKeyId": "default-master-key",
      "EnableTamperEvidentLogging": true,
      "S3AuditBucket": "unified-gateway-audit-logs"
    },
    "Storage": {
      "DataDirectory": "./data",
      "RegistryFileName": "app_registry.json"
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      }
    }
  }
}
